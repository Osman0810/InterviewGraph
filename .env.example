# PostgreSQL configuration for local development.
POSTGRES_DB=interview_graph
POSTGRES_USER=interview_graph
POSTGRES_PASSWORD=change_me

# Used when FastAPI runs directly on the host. Docker Compose overrides the host
# with the database service name for the API container.
DATABASE_URL=postgresql+psycopg://interview_graph:change_me@localhost:5432/interview_graph

# Server-side Gemini configuration. Never expose these values to the frontend.
AI_PROVIDER=gemini
ALLOW_PROVIDER_FALLBACK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Server-side OpenAI configuration. Never expose these values to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
INTERVIEW_QUESTION_LIMIT=12

# API safeguards. The in-process limiter is suitable for local development;
# use a shared gateway or Redis-backed limiter when deploying multiple API instances.
FRONTEND_ORIGIN=http://localhost:3000
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
